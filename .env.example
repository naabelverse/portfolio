# Copy this file to .env.local and fill in the value.
#
#   cp .env.example .env.local
#
# .env.local is gitignored. This file is not — never put a secret in it.

# Formspree form id, from https://formspree.io (the free tier is enough).
# Create a form, then copy the id out of its endpoint URL:
#   https://formspree.io/f/xdkolabc  ->  xdkolabc
#
# NEXT_PUBLIC_ means this value is inlined into the browser bundle. That is
# correct here — a Formspree form id is public by design. Do not add real
# secrets with this prefix.
#
# Leave it empty and the contact form degrades to a plain mailto: link, so the
# site still works before you set this up.
NEXT_PUBLIC_FORMSPREE_ID=
